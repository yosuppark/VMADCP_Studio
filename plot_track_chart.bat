@echo off
REM ========================================================
REM Vessel Mounted ADCP Track Chart & Current Vector Plot
REM Generated by VMADCP Post-Processing System
REM ========================================================

set OUTPUT_NAME=VMADCP_Track_Chart
set REGION=129.4389/129.4527/36.2543/36.2678
set PROJECTION=M16c

echo [GMT] Generating publication-quality ADCP Track Chart...
gmt begin %OUTPUT_NAME% png,pdf
    gmt set FONT_ANNOT_PRIMARY 9p,Helvetica,black
    gmt set FONT_LABEL 11p,Helvetica-Bold,black
    gmt set MAP_FRAME_TYPE fancy

    REM 1. Basemap and Coastlines
    gmt basemap -R%REGION% -J%PROJECTION% -Bafg -B+t"Vessel Mounted ADCP Track & Current Vectors"
    gmt coast -W0.5p,black -G230/230/230 -S210/230/250 -Df -Ia/0.25p,blue

    REM 2. Plot Cruise Track Line
    gmt plot track_line.txt -W1.5p,darkgray

    REM 3. Plot Current Vectors (gmt velo)
    REM Vector scale: 1 m/s = 1.0 cm on map
    gmt velo current_vectors.txt -Se1.00/0.95/0 -W1.0p,red -Gred

    REM 4. Start & End points
    echo 129.4405464587087 36.2660314200786 Start | gmt text -F+f9p,Helvetica-Bold,forestgreen+jRB -D0.2c/0.2c
    echo 129.44940767267232 36.256112673737476 End   | gmt text -F+f9p,Helvetica-Bold,firebrick+jLT -D0.2c/0.2c

    REM 5. Velocity Vector Legend
    echo 129.4413 36.2567 0.5 0.0 0.0 0.0 0.0 | gmt velo -Se1.00/0.95/0 -W1.2p,black -Gblack
    echo 129.4413 36.2563 0.5 m/s | gmt text -F+f8p,Helvetica-Bold,black+jCT
gmt end show

echo [GMT] Plotting complete: %OUTPUT_NAME%.png
